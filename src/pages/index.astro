---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="flex min-h-screen items-center justify-center px-4">
    <section class="flex flex-col items-center gap-8 text-center max-w-2xl">

      <img
        src="/profile.jpg"
        alt="Alex Tio"
        width="128"
        height="128"
        class="avatar rounded-full border-4 shadow-2xl"
      />

      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-7xl">
        👋 Hi, I'm <span class="text-gradient">Alex</span>.
      </h1>

      <p class="text-lg sm:text-xl md:text-2xl">
        Former English teacher turned AI platform engineer. 
      </p>

      <p class="text-lg sm:text-xl md:text-2xl max-w-xl" style="color: var(--muted-foreground)">
       Currently working on Biomedical AI at UT Health. 
      </p>

      <nav aria-label="Social links">
        <ul role="list" class="dock flex gap-2 rounded-2xl px-6 py-4 backdrop-blur-md">
          <li>
            <a
              href="https://github.com/alextio"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub"
              class="dock-link"
            >
              <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
              </svg>
            </a>
          </li>
          <li>
            <a
              href="https://linkedin.com/in/alextio"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
              class="dock-link"
            >
              <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
              </svg>
            </a>
          </li>
          <li>
            <a
              href="/alextio_resume.pdf"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Resume"
              class="dock-link"
            >
              <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm4 18H6V4h7v5h5v11z" />
                <path d="M9 12h6v2H9zm0 4h6v2H9z" />
              </svg>
            </a>
          </li>
        </ul>
      </nav>

    </section>
  </main>
</Layout>

<style>
  /* Entrance animations */
  .avatar {
    border-color: oklch(0.546 0.245 262.881 / 0.2);
    animation: scale-in 0.6s ease-out 0s both;
  }

  h1 {
    animation: fade-in-up 0.6s ease-out 0.2s both;
  }

  section > p:first-of-type {
    animation: fade-in-up 0.6s ease-out 0.4s both;
  }

  section > p:last-of-type {
    animation: fade-in-up 0.6s ease-out 0.6s both;
  }

  nav {
    animation: fade-in-up 0.6s ease-out 0.8s both;
  }

  /* Gradient text on name */
  .text-gradient {
    background: linear-gradient(
      to right,
      oklch(0.546 0.245 262.881),
      oklch(0.546 0.245 262.881 / 0.7)
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Dock container */
  .dock {
    background-color: oklch(1 0 0 / 0.05);
  }

  /* Dock link hover — spring-like cubic-bezier overshoots */
  .dock-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.5rem;
    color: oklch(0.985 0 0);
    transition:
      transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .dock-link:hover {
    transform: scale(1.4) translateY(-20px);
    background-color: oklch(0.546 0.245 262.881 / 0.2);
    color: oklch(0.546 0.245 262.881);
  }
</style>
